# Copy this file to .env.datahub-vps on the VPS before starting DataHub.
#
# Generated local-test secrets.
#
# These values are for the isolated VPS capacity test only. Replace every
# "change-me" value before exposing the service beyond a private test host.

DATAHUB_VERSION=v1.4.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.4.0

DATAHUB_MAPPED_FRONTEND_PORT=9002
DATAHUB_MAPPED_GMS_PORT=28080
DATAHUB_MAPPED_MYSQL_PORT=3306
DATAHUB_MAPPED_OPENSEARCH_PORT=9200
DATAHUB_MAPPED_KAFKA_PORT=9092

DATAHUB_MYSQL_PASSWORD=datahub
DATAHUB_MYSQL_ROOT_PASSWORD=datahub

DATAHUB_TOKEN_SERVICE_SIGNING_KEY=dTRnN1A4eUJrM2pWNXNYOUg0ZkM2YVJ2bDVlVzh0WTI=
DATAHUB_TOKEN_SERVICE_SALT=cDlTNncyZEg0ak01bFc4eVg3ZkM2YVJ2bDVlVzh0WTI=
DATAHUB_FRONTEND_SECRET=bTVTNncyZEg0ak01bFc4eVg3ZkM2YVJ2bDVlVzh0WTI=
DATAHUB_SYSTEM_CLIENT_SECRET=YTZTNncyZEg0ak01bFc4eVg3ZkM2YVJ2bDVlVzh0WTI=

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx768m -Dlog4j2.formatMsgNoLookups=true
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
DATAHUB_GMS_JAVA_OPTS=-Xms512m -Xmx1024m
DATAHUB_FRONTEND_JAVA_OPTS=-Xms256m -Xmx512m -Dhttp.port=9002 -Dconfig.file=datahub-frontend/conf/application.conf -Djava.security.auth.login.config=datahub-frontend/conf/jaas.conf -Dlogback.configurationFile=datahub-frontend/conf/logback.xml -Dpidfile.path=/dev/null

MONITOR_SECONDS=900
MONITOR_INTERVAL_SECONDS=15
