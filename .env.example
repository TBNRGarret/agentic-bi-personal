# Shared local environment for all workflows

# MinIO / raw landing
MINIO_ENDPOINT=localhost:19001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-bi-raw
MINIO_SECURE=false

# PostgreSQL DWH
POSTGRES_DWH_HOST=localhost
POSTGRES_DWH_PORT=5433
POSTGRES_DWH_USER=dwh_admin
POSTGRES_DWH_PASSWORD=dwh_admin_password
POSTGRES_DWH_DB=central_dwh
POSTGRES_DWH_FALLBACK_HOST=localhost

# Airflow metadata DB
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow_password

# Observation Service / backend
OBSERVATION_ENVIRONMENT=local
OBSERVATION_REPO_ROOT=/workspace
SOURCE_APP_ID=agentic-bi-terminal-agent
OBSERVATION_TERMINAL_TIMEOUT_SECONDS=5
OBSERVATION_TERMINAL_MAX_OUTPUT_CHARS=12000
OBSERVATION_TERMINAL_ALLOWLIST=date,whoami,pwd,ls,git status,python --version,python -V
OBSERVATION_QUERY_TIMEOUT_SECONDS=10
OBSERVATION_AGENT_RETRY_COUNT=2
OBSERVATION_AGENT_SYNTHESIS_TIMEOUT_SECONDS=120
OBSERVATION_SQL_CANDIDATE_COUNT=3
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=securepassword
CLICKHOUSE_SECURE=false
CLICKHOUSE_DATABASE=default
CLICKHOUSE_ANALYTICS_SCHEMAS=vsf_mart
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=60
DWH_POSTGRES_DSN=postgresql://dwh_admin:dwh_admin_password@postgres-dwh:5432/central_dwh
DATAHUB_GMS_URL=http://localhost:28080
DATAHUB_TOKEN=
DATAHUB_TIMEOUT_SECONDS=15
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=agentic_bi_schema
FALKORDB_ENABLED=true
FALKORDB_TIMEOUT_SECONDS=5
FALKORDB_SYNC_TTL_SECONDS=60
METABASE_URL=http://localhost:3000
METABASE_PUBLIC_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
DISABLED_ANALYTICS_TABLES=

# Auth / security
AUTH_ENABLED=true
AUTH_JWT_SECRET=generate_a_long_random_secret
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_MINUTES=480
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change_me
AUTH_BOOTSTRAP_ROLE=admin
AUTH_BOOTSTRAP_TEAM=platform

# LLM / provider configuration
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-120b:free
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_SQL_TIMEOUT_SECONDS=90
LLM_SQL_MAX_RETRIES=1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3003
OPENROUTER_APP_NAME=Agentic BI Monitoring
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TABLE_SELECTOR_EMBEDDING_ENABLED=true
TABLE_SELECTOR_EMBEDDING_TIMEOUT_SECONDS=8

# Telemetry / traces
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_SERVICE_NAME=agentic-bi-observation-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
LOG_LEVEL=INFO

# Frontend / Vite
VITE_OBS_API_URL=http://localhost:18000
VITE_METABASE_URL=http://localhost:3000
VITE_FALKORDB_BROWSER_URL=http://localhost:3004
VITE_BI_LLM_MODEL=openai/gpt-oss-120b:free
VITE_LLM_MODEL=openai/gpt-oss-120b:free

# Metadata MCP defaults
DATAHUB_MCP_TRANSPORT=stdio
DATAHUB_MCP_DEFAULT_SCHEMA=vsf_mart
DATAHUB_MCP_DEFAULT_PLATFORM=clickhouse
DATAHUB_MCP_MAX_TABLES=5
DATAHUB_MCP_MAX_COLUMNS=80
DATAHUB_CLICKHOUSE_PLATFORM_INSTANCE=agentic_clickhouse

# DataHub VPS stack
# Generate the DataHub secret values with:
#   openssl rand -base64 32
DATAHUB_VERSION=v1.4.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.4.0
DATAHUB_MAPPED_FRONTEND_PORT=9002
DATAHUB_MAPPED_GMS_PORT=28080
DATAHUB_MAPPED_MYSQL_PORT=3306
DATAHUB_MAPPED_OPENSEARCH_PORT=9200
DATAHUB_MAPPED_KAFKA_PORT=9092
DATAHUB_MYSQL_PASSWORD=datahub
DATAHUB_MYSQL_ROOT_PASSWORD=datahub
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=change-me-run-openssl-rand-base64-32
DATAHUB_TOKEN_SERVICE_SALT=change-me-run-openssl-rand-base64-32
DATAHUB_FRONTEND_SECRET=change-me-run-openssl-rand-base64-32
DATAHUB_SYSTEM_CLIENT_SECRET=change-me-run-openssl-rand-base64-32
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx768m -Dlog4j2.formatMsgNoLookups=true
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
DATAHUB_GMS_JAVA_OPTS=-Xms512m -Xmx1024m
DATAHUB_FRONTEND_JAVA_OPTS=-Xms256m -Xmx512m -Dhttp.port=9002 -Dconfig.file=datahub-frontend/conf/application.conf -Djava.security.auth.login.config=datahub-frontend/conf/jaas.conf -Dlogback.configurationFile=datahub-frontend/conf/logback.xml -Dpidfile.path=/dev/null
MONITOR_SECONDS=900
MONITOR_INTERVAL_SECONDS=15

# Evaluation helpers
EVAL_API_URL=http://localhost:18000
EVAL_USERNAME=admin
EVAL_PASSWORD=AgenticBI_Admin_Local_2026!
EVAL_TIMEOUT_SECONDS=120